# ============================================================================
# Guardián del Agua — .gitignore
# CRÍTICO: este archivo bloquea claves y credenciales antes de hacer push.
# ============================================================================

# ----------------------------------------------------------------------------
# SECRETS — NUNCA subir estos archivos al repositorio
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.local.example

# Google Cloud service account keys
gcp-key.json
gcp-*.json
*-service-account.json
service-account*.json
firebase-adminsdk-*.json
credentials.json

# Otros secrets comunes
*.pem
*.key
*.crt
*.p12
secrets/
secrets.yaml
secrets.yml

# ----------------------------------------------------------------------------
# Python
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
env/
ENV/
.venv/
.env/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml
*.cover
*.py,cover
.cache

# Jupyter
.ipynb_checkpoints
*.ipynb_checkpoints

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.ruff_cache/

# ----------------------------------------------------------------------------
# Node.js / Next.js / Frontend
# ----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Next.js
.next/
out/
next-env.d.ts

# Production builds
build/

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# Turbo
.turbo

# ----------------------------------------------------------------------------
# ML artifacts y datos sensibles
# ----------------------------------------------------------------------------
# Modelos entrenados — se regeneran con ml/train.py si hace falta
backend/ml/*.pkl
backend/ml/*.joblib
backend/ml/*.h5
backend/ml/*.onnx

# Backups de CSV — solo el csv "oficial" va al repo
backend/ml/*_backup.csv
backend/ml/loreto_historical_synthetic_backup.csv

# Imágenes Sentinel cacheadas
backend/data/sentinel_cache/
backend/data/*.png
backend/data/*.tif
backend/data/*.tiff

# ----------------------------------------------------------------------------
# Archivos de prueba / temporales
# ----------------------------------------------------------------------------
test_denuncia*.pdf
*.tmp
*.bak
*.swp
*~

# Logs
*.log
logs/

# ----------------------------------------------------------------------------
